[Unit]
Description=Employee Attendance (absen_ntp) Python Backend Server
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/home/debian/www/attendance
ExecStart=/home/debian/www/attendance/venv/bin/python3 /home/debian/www/attendance/server.py

# Restart policy: otomatis nyalakan ulang jika terjadi crash/kill
Restart=always
RestartSec=3

# Resource and security limits
ProtectSystem=full
PrivateTmp=true

# Standard logging diarahkan ke journalctl & logs/app.log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=attendance-server

[Install]
WantedBy=multi-user.target
